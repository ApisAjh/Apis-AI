# Untuk testing lokal dengan `vercel dev` saja.
# Salin ke ".env" di root project (sejajar dengan package.json ini).
#
# PENTING: file ini TIDAK dipakai saat production di Vercel.
# Untuk production, isi variabel yang sama di:
#   Vercel Dashboard -> Project kamu -> Settings -> Environment Variables
# lalu redeploy.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ALLOWED_ORIGIN=*
