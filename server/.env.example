# Salin file ini menjadi ".env" lalu isi API key kamu sendiri.
# JANGAN pernah commit file ".env" (yang sudah berisi key asli) ke Git publik.

# Wajib diisi. Dapatkan di https://aistudio.google.com/apikey (Google AI Studio)
# atau lewat Google Cloud Console jika memakai Vertex AI.
GEMINI_API_KEY=

# Opsional. Model Gemini yang dipakai untuk membalas chat.
GEMINI_MODEL=gemini-3.5-flash

# Opsional. Port server backend + frontend statis.
PORT=3000

# Opsional. Batasi domain yang boleh memanggil /api/chat (mis. https://situskamu.com).
# Biarkan "*" jika frontend & backend selalu dijalankan dari server yang sama.
ALLOWED_ORIGIN=*
